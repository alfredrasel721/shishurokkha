{
  "name": "shishurokkha-pairing-api",
  "private": true,
  "version": "0.1.0",
  "description": "Separate Cloudflare Worker backend for ShishuRokkha secure pairing",
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --lib ES2022,DOM --types @cloudflare/workers-types src/index.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 execute shishurokkha-pairing --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
